<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!-- Staging: the release MR removes this mapping once SAIB publishes these versions. -->
  <packageSources>
    <clear />
    <add key="local-packages" value="../local-packages" />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
  <packageSourceMapping>
    <packageSource key="local-packages">
      <package pattern="SAIB.Cbor" />
      <package pattern="SAIB.Blake2Fast" />
    </packageSource>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
