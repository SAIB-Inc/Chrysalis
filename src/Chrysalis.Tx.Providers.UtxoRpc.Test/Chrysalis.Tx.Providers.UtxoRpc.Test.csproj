<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net11.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <OutputType>Exe</OutputType>
    <RootNamespace>Chrysalis.Tx.Providers.UtxoRpcTests</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <PackageReference Include="Google.Protobuf" />
    <PackageReference Include="Grpc.AspNetCore.Server" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="xunit.runner.visualstudio">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../Chrysalis.Tx.Providers.UtxoRpc/Chrysalis.Tx.Providers.UtxoRpc.csproj" />
    <ProjectReference Include="../Chrysalis/Chrysalis.csproj" />
    <Compile Include="../Chrysalis.Tx.Test/Providers/StubHttpHandler.cs" Link="Providers/StubHttpHandler.cs" />
    <Compile Include="../Chrysalis.Tx.Test/Providers/BlockfrostRecording.cs" Link="Providers/BlockfrostRecording.cs" />
    <None Include="../Chrysalis.Tx.Test/TestData/providers/blockfrost/**"
          Link="TestData/providers/blockfrost/%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <None Update="Golden/**" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
