<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net11.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <OutputType>Exe</OutputType>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="xunit.runner.visualstudio">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="coverlet.collector">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../Chrysalis.Network/Chrysalis.Network.csproj" />
    <ProjectReference Include="../Chrysalis.Tx/Chrysalis.Tx.csproj" />
    <ProjectReference Include="../Chrysalis.Tx.Providers.Blockfrost/Chrysalis.Tx.Providers.Blockfrost.csproj" />
    <ProjectReference Include="../Chrysalis.Tx.Providers.Kupmios/Chrysalis.Tx.Providers.Kupmios.csproj" />
    <ProjectReference Include="../Chrysalis.Tx.Providers.Ouroboros/Chrysalis.Tx.Providers.Ouroboros.csproj" />
    <ProjectReference Include="../Chrysalis.Wallet/Chrysalis.Wallet.csproj" />
    <EmbeddedResource Include="Golden/**/*" LogicalName="Golden/%(RecursiveDir)%(Filename)%(Extension)" />
    <EmbeddedResource Include="../Chrysalis.Network.Tests/Fixtures/Preprod/**/*"
                      LogicalName="Preprod/%(RecursiveDir)%(Filename)%(Extension)" />
    <EmbeddedResource Include="../../test/devnet/shelley-spec.json" LogicalName="Devnet/shelley-spec.json" />
  </ItemGroup>
  <ItemGroup>
    <Compile Include="../Chrysalis.Tx.Test/CliSnapshotProvider.cs" Link="CliSnapshotProvider.cs" />
  </ItemGroup>
</Project>
