<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net11.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <OutputType>Exe</OutputType>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="xunit.runner.visualstudio">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <Compile Include="../Chrysalis.Codec.Test/AllocationAssert.cs" Link="AllocationAssert.cs" />
    <None Include="../Chrysalis.Network.Tests/Fixtures/Preprod/current-protocol-parameters.json"
          Link="TestData/cli/inputs/g1/current-protocol-parameters.json" CopyToOutputDirectory="PreserveNewest" />
    <None Include="../Chrysalis.Network.Tests/Fixtures/Preprod/wire/c1-in-p7-007.cbor"
          Link="TestData/cli/inputs/g1/c1-in-p7-007.cbor" CopyToOutputDirectory="PreserveNewest" />
    <None Include="../Chrysalis.Network.Tests/Fixtures/Preprod/manifest.json"
          Link="TestData/g1/manifest.json" CopyToOutputDirectory="PreserveNewest" />
    <None Include="../Chrysalis.Network.Tests/Fixtures/Preprod/transactions/transfer-ouroboros.cbor"
          Link="TestData/g1/transfer-ouroboros.cbor" CopyToOutputDirectory="PreserveNewest" />
    <None Include="../Chrysalis.Network.Tests/Fixtures/Preprod/wire/c12-out-p6-002.cbor"
          Link="TestData/g1/c12-out-p6-002.cbor" CopyToOutputDirectory="PreserveNewest" />
    <None Include="../Chrysalis.Network.Tests/Fixtures/Preprod/wire/c10-out-p6-002.cbor"
          Link="TestData/g1/c10-out-p6-002.cbor" CopyToOutputDirectory="PreserveNewest" />
    <None Include="../Chrysalis.Network.Tests/Fixtures/Preprod/wire/c10-in-p6-002.cbor"
          Link="TestData/g1/c10-in-p6-002.cbor" CopyToOutputDirectory="PreserveNewest" />
    <None Update="TestData/**" CopyToOutputDirectory="PreserveNewest" />
    <Compile Include="../Chrysalis.Tx.Providers.UtxoRpc.Test/LedgerParameters.cs" Link="Providers/LedgerParameters.cs" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../Chrysalis.Tx/Chrysalis.Tx.csproj" />
    <ProjectReference Include="../Chrysalis/Chrysalis.csproj" />
    <ProjectReference Include="../Chrysalis.Tx.Providers.Koios/Chrysalis.Tx.Providers.Koios.csproj" />
    <ProjectReference Include="../Chrysalis.Codec.CodeGen/Chrysalis.Codec.CodeGen.csproj"
                      OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
  </ItemGroup>

</Project>
