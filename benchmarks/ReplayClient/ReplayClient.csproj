<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net11.0</TargetFramework>
    <FlyHarnessProject Condition="'$(FlyHarnessProject)' == ''">$(MSBuildThisFileDirectory)../Chrysalis.Benchmarks/Chrysalis.Benchmarks.csproj</FlyHarnessProject>
    <ServerGarbageCollection>false</ServerGarbageCollection>
    <ConcurrentGarbageCollection>true</ConcurrentGarbageCollection>
  </PropertyGroup>
  <ItemGroup><ProjectReference Include="$(FlyHarnessProject)" /></ItemGroup>
</Project>
