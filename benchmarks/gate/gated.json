    "Signing and addresses": {"bytes": ["CoreBench.Sign", "CoreBench.Verify", "CoreBench.Address*"], "time": ["time/micro-signing"]},
    "Transaction building and fees": {"bytes": ["TxBench.*"], "time": ["time/micro-transactions"]},
    "Plutus": {"bytes": ["VmBench.*", "CorpusVmBench.*"], "time": ["time/micro-plutus"]},
