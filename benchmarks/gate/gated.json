    "timePairs": 16
  },
  "direct": {"FieldReadBench.ReadEveryField": "range"},
  "replays": ["tcp", "offline", "offline-n2c"],
  "time": {
    "scope": "D51: sync-path replays and every other hot path; MR3 implements time",
    "required": ["time/preprod-tcp", "time/preprod-offline", "time/micro-hashing", "time/micro-signing", "time/micro-transactions", "time/micro-plutus", "time/micro-encoding", "time/micro-n2c"],
