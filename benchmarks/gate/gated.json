      "tcp": {"band": 0.0307, "design": "long", "machine": "performance-8x", "source": "P1-run3"}
    }
  },
  "areas": {
    "Network receive": {"bytes": ["replay/*", "CoreBench.MuxDecodeHeader", "NetworkHeaderBench.*"], "time": ["time/preprod-*", "time/micro-n2c"]},
    "Network send": {"bytes": ["CoreBench.MuxEncode*", "replay/tcp/*"], "time": ["time/preprod-tcp"]},
    "CBOR decode": {"bytes": ["*Decode*", "CoreBench.*Read", "FieldReadBench.ReadEveryField"], "time": ["time/preprod-*"]},
